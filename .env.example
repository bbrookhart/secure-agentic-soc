# Agentic SOC configuration. Copy to .env and edit as needed.
# Every variable is optional; the defaults run the full local stack.

# --- LLM -------------------------------------------------------------------
SOC_OLLAMA_BASE_URL=http://localhost:11434
SOC_OLLAMA_MODEL=llama3.2
SOC_LLM_TEMPERATURE=0.0
SOC_LLM_TIMEOUT_SECONDS=120

# Set true to run with no LLM at all (deterministic rule-based fallbacks).
SOC_OFFLINE_MODE=false

# --- Embeddings ------------------------------------------------------------
# tfidf  = deterministic, offline, no model download (default)
# ollama = real semantic embeddings; requires `ollama pull nomic-embed-text`
SOC_EMBEDDING_BACKEND=tfidf
SOC_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Human-in-the-loop policy ---------------------------------------------
# Triage severity at or above which a human must approve: info|low|medium|high|critical
SOC_HITL_SEVERITY_THRESHOLD=high
# Below this triage confidence, escalate to a human regardless of severity.
SOC_HITL_MIN_CONFIDENCE=0.55

# --- Safety limits ---------------------------------------------------------
SOC_MAX_TOOL_CALLS_PER_RUN=40
SOC_TOOL_RATE_LIMIT_PER_MINUTE=30
SOC_MAX_UNTRUSTED_CHARS=4000

# --- Audit durability and forwarding ---------------------------------------
# The local hash chain is tamper-EVIDENT, not tamper-proof: anyone with code
# execution here can recompute it. Forwarding each event to storage under
# different credentials is what makes a later rewrite detectable, because the
# two copies then disagree.
SOC_AUDIT_DURABLE_WRITES=true

# Ed25519 signing gives non-repudiation to an auditor holding only the public
# key -- verification stops requiring the power to forge (AU-10). It does NOT
# stop an attacker who holds the key: for that, use a KMS or HSM so the app
# can sign without reading the key (AuditSigner is the seam).
SOC_AUDIT_SIGNING_ENABLED=true
# SOC_AUDIT_SIGNING_KEY_PATH=state/audit/signing-key.pem
# Signed chain-head anchors, forwarded off-host. An attacker cannot retract
# an anchor that already left, so a rewritten log diverges from it.
SOC_AUDIT_ANCHOR_INTERVAL=25

# Retention (AU-11). Rotation bounds disk use; anything past the last segment
# is deleted, which is the argument for forwarding -- off-host retention is
# not tied to this volume.
SOC_AUDIT_MAX_SEGMENT_BYTES=67108864
SOC_AUDIT_MAX_SEGMENTS=10
# Correlation cannot see further back than this.
SOC_CASE_RETENTION_DAYS=365

# Encryption at rest (SC-28) is a volume-level concern -- app-level encryption
# would put the keys beside the data. Declarative only; the app cannot verify
# it and reports it as an operator assertion.
SOC_STATE_VOLUME_ENCRYPTED=false
# SOC_AUDIT_FORWARD_URL=https://collector.internal/ingest
# SOC_AUDIT_FORWARD_TOKEN=
# SOC_AUDIT_SYSLOG_ADDRESS=/dev/log

# --- Approval console authentication ---------------------------------------
# Streamlit has no authentication. Front the console with an authenticating
# proxy that STRIPS this header from inbound requests and sets it itself, then
# name it here; the approval gate refuses to record a decision without it.
# Set to false only for local single-user runs -- decisions are then recorded
# as 'unauthenticated' in the audit trail rather than silently trusted.
SOC_APPROVAL_IDENTITY_HEADER=X-Forwarded-User
SOC_REQUIRE_AUTHENTICATED_APPROVAL=true

# --- Approval authorization (RBAC) -----------------------------------------
# Authority comes from proxy-asserted group membership. Recognised groups:
#   soc-viewer    read only, signs nothing
#   soc-analyst   up to high severity, low-impact actions, non-critical assets
#   soc-senior    any severity, disruptive containment, critical assets
#   soc-admin     as above, plus policy and capability configuration
# An identity with no recognised group holds no approval authority.
SOC_APPROVAL_ROLES_HEADER=X-Forwarded-Groups

# Separation of duties (NIST 800-53 AC-5): whoever started a run may not
# approve it. A single-operator deployment cannot satisfy this -- the CLI
# initiator and approver are the same person -- so turning it off is a
# deliberate choice rather than a default.
SOC_REQUIRE_SEPARATION_OF_DUTIES=true

# Two-person integrity for disruptive containment on business-critical assets.
# Off by default: it doubles the cost of every such approval, which is right
# in some environments and pure friction in others.
SOC_REQUIRE_TWO_PERSON_APPROVAL=false

# --- Secrets ---------------------------------------------------------------
# Not required: all bundled tools are offline. Present to demonstrate correct
# secret handling -- any value set here is registered with the redaction engine
# and scrubbed from prompts, audit logs and tool output.
# SOC_THREAT_INTEL_API_KEY=
